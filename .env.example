MATTERPORT_TOKEN_ID=
MATTERPORT_TOKEN_SECRET=
MATTERPORT_MODEL_ID=zvKHR9DHNjJ
# Unzipped CoStar hackathon kit, read by `cargo run -p import-property`.
COSTAR_DATA_PATH=data/costar-kit
# Showcase SDK key for the web app's Textured view (not the Model API token).
# It is sent to the browser, so it must allow localhost in its domain list.
MATTERPORT_SDK_KEY=

# Gemini scenario generator. The model must support function calling.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# World server (crates/server). The web app proxies /api/world to this address.
TFLOP_SERVER_ADDR=127.0.0.1:3000
# Optional: CFAST 7.7.7 executable used by POST /api/fire/simulate/hybrid.
# Leave empty to use the copy cargo builds from crates/cfast/vendor (needs gfortran).
CFAST_BIN=
# TFLOP_SCENE_PATH=data/prepared-scenes/zvKHR9DHNjJ.json
